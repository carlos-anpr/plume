{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plume",
  "version": "0.1.1",
  "identifier": "dev.plume.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Plume",
        "width": 1280,
        "height": 820,
        "minWidth": 560,
        "minHeight": 380,
        "decorations": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Bloc de notas con vista previa Markdown",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx",
          "txt"
        ],
        "name": "Markdown",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  }
}